{
  "hosting": {
    "public": "website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "serve-guide.sh"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "/guide/*.md",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, max-age=0" }
        ]
      }
    ]
  }
}